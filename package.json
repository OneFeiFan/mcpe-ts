{
  "name": "mcpe-ts",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Minecraft PE 0.6.1 behavioral reimplementation in pure TypeScript",
  "scripts": {
    "dev:web": "pnpm --filter @mcpe/web dev",
    "dev:server": "pnpm --filter @mcpe/server dev",
    "build": "pnpm --filter @mcpe/web build",
    "typecheck": "pnpm -r --if-present typecheck && tsc -p tests/tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "ledger": "node tools/ledger.mjs",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "ci": "pnpm typecheck && pnpm test && pnpm build"
  },
  "devDependencies": {
    "@eslint/js": "latest",
    "@mcpe/client": "workspace:*",
    "@mcpe/core": "workspace:*",
    "@mcpe/locale": "workspace:*",
    "@mcpe/nbt": "workspace:*",
    "@mcpe/platform": "workspace:*",
    "@mcpe/util": "workspace:*",
    "@mcpe/world": "workspace:*",
    "@types/node": "latest",
    "eslint": "latest",
    "eslint-config-prettier": "latest",
    "playwright": "^1.63.0",
    "prettier": "latest",
    "tsx": "latest",
    "typescript": "6.0.3",
    "typescript-eslint": "latest",
    "vite": "latest",
    "vitest": "latest"
  }
}
