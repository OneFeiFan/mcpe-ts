{
  "env": {
    "REF": "D:/Work/mcpe-reimplementation/reference/minecraft-pe"
  },
  "permissions": {
    "allow": [
      "Bash(pnpm *)",
      "Bash(npx vitest*)",
      "Bash(npx tsc*)",
      "Bash(node tools/*)",
      "Bash(python tools/porting/*)",
      "Bash(python3 tools/porting/*)",
      "Bash(git status*)",
      "Bash(git diff*)",
      "Bash(git log*)",
      "Bash(git add*)",
      "Bash(git commit*)",
      "Bash(rg *)",
      "Bash(grep *)"
    ],
    "deny": [
      "Bash(git push*)",
      "Bash(git reset --hard*)",
      "Bash(rm -rf *)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [{ "type": "command", "command": "node tools/hooks/guard.mjs" }]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [{ "type": "command", "command": "node tools/hooks/post-edit.mjs" }]
      }
    ],
    "Stop": [
      {
        "hooks": [{ "type": "command", "command": "node tools/hooks/stop-check.mjs" }]
      }
    ]
  }
}
